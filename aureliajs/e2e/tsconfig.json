{
	"$schema": "https://json.schemastore.org/tsconfig",
	"extends": "../tsconfig.json",
	"include": [
		"**/.*.js",
		"**/.*.cjs",
		"**/.*.mjs",
		"**/*.js",
		"**/*.cjs",
		"**/*.mjs",
		"**/.*.ts",
		"**/.*.cts",
		"**/.*.mts",
		"**/*.ts",
		"**/*.cts",
		"**/*.mts"
	],
	"exclude": [
		"bower_components",
		"jspm_packages",
		"node_modules",
		"vendor",
		".env",
		"env",
		".venv",
		"venv",
		".env.bak",
		"env.bak",
		".venv.bak",
		"venv.bak",
		"ENV",
		"__pycache__"
	],
	"compilerOptions": {
		"rootDir": ".",
		"baseUrl": ".",
		"paths": {},
		"types": ["playwright", "lodash-es"],

		"incremental": true,
		"tsBuildInfoFile": ".tsbuildinfo"
	}
}