{
	"$schema": "https://json.schemastore.org/tsconfig",
	"compileOnSave": false,
	"atom": { "rewriteTsconfig": false },
	"include": [
		".*.js",
		".*.cjs",
		".*.mjs",
		"*.js",
		"*.cjs",
		"*.mjs",
		".*.ts",
		".*.cts",
		".*.mts",
		"*.ts",
		"*.cts",
		"*.mts",
		"aurelia_project/**/.*.js",
		"aurelia_project/**/.*.cjs",
		"aurelia_project/**/.*.mjs",
		"aurelia_project/**/*.js",
		"aurelia_project/**/*.cjs",
		"aurelia_project/**/*.mjs",
		"aurelia_project/**/.*.ts",
		"aurelia_project/**/.*.cts",
		"aurelia_project/**/.*.mts",
		"aurelia_project/**/*.ts",
		"aurelia_project/**/*.cts",
		"aurelia_project/**/*.mts",
		"e2e/**/.*.js",
		"e2e/**/.*.cjs",
		"e2e/**/.*.mjs",
		"e2e/**/*.js",
		"e2e/**/*.cjs",
		"e2e/**/*.mjs",
		"e2e/**/.*.ts",
		"e2e/**/.*.cts",
		"e2e/**/.*.mts",
		"e2e/**/*.ts",
		"e2e/**/*.cts",
		"e2e/**/*.mts",
		"src/**/.*.js",
		"src/**/.*.cjs",
		"src/**/.*.mjs",
		"src/**/*.js",
		"src/**/*.cjs",
		"src/**/*.mjs",
		"src/**/.*.ts",
		"src/**/.*.cts",
		"src/**/.*.mts",
		"src/**/*.ts",
		"src/**/*.cts",
		"src/**/*.mts",
		"tailwindcss-plugins/**/.*.js",
		"tailwindcss-plugins/**/.*.cjs",
		"tailwindcss-plugins/**/.*.mjs",
		"tailwindcss-plugins/**/*.js",
		"tailwindcss-plugins/**/*.cjs",
		"tailwindcss-plugins/**/*.mjs",
		"tailwindcss-plugins/**/.*.ts",
		"tailwindcss-plugins/**/.*.cts",
		"tailwindcss-plugins/**/.*.mts",
		"tailwindcss-plugins/**/*.ts",
		"tailwindcss-plugins/**/*.cts",
		"tailwindcss-plugins/**/*.mts",
		"test/**/.*.js",
		"test/**/.*.cjs",
		"test/**/.*.mjs",
		"test/**/*.js",
		"test/**/*.cjs",
		"test/**/*.mjs",
		"test/**/.*.ts",
		"test/**/.*.cts",
		"test/**/.*.mts",
		"test/**/*.ts",
		"test/**/*.cts",
		"test/**/*.mts"
	],
	"exclude": [
		"bower_components",
		"jspm_packages",
		"node_modules",
		"vendor",
		".env",
		"env",
		".venv",
		"venv",
		".env.bak",
		"env.bak",
		".venv.bak",
		"venv.bak",
		"ENV",
		"__pycache__",
		".swc",
		"scripts"
	],
	"compilerOptions": {
		"exactOptionalPropertyTypes": true,
		"noFallthroughCasesInSwitch": true,
		"noImplicitOverride": true,
		"noImplicitReturns": true,
		"noPropertyAccessFromIndexSignature": true,
		"noUncheckedIndexedAccess": true,
		"noUnusedLocals": false,
		"noUnusedParameters": false,
		"strict": true,
		"strictPropertyInitialization": false,

		"module": "esnext",
		"moduleResolution": "node",
		"resolveJsonModule": true,
		"rootDir": ".",
		"baseUrl": ".",
		"paths": {
			"src/*": ["src/*"],
			"resources/*": ["src/resources/*"],
			"attributes/*": ["src/resources/attributes/*"],
			"bindingBehaviors/*": ["src/resources/binding-behaviors/*"],
			"elements/*": ["src/resources/elements/*"],
			"valueConverters/*": ["src/resources/value-converters/*"],
			"helpers/*": ["src/resources/helpers/*"],
			"services/*": ["src/resources/services/*"],
			"modules/*": ["src/modules/*"],
			"states/*": ["src/states/*"],
			"store/*": ["src/store/*"]
		},
		"types": ["lodash-es", "@total-typescript/ts-reset"],

		"declaration": false,
		"importHelpers": true,
		"removeComments": true,
		"sourceMap": true,

		"allowJs": true,
		"checkJs": true,

		"allowSyntheticDefaultImports": true,
		"esModuleInterop": true,

		"emitDecoratorMetadata": true,
		"experimentalDecorators": true,
		"lib": ["esnext", "dom"],
		"target": "es2017",

		"incremental": true,
		"tsBuildInfoFile": ".tsbuildinfo",

		"skipLibCheck": true
	}
}